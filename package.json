{
  "name": "studiorack-app",
  "version": "3.0.3",
  "productName": "StudioRack",
  "description": "Audio plugin app, searchable list of plugins to install and share",
  "type": "module",
  "main": "build/electron-src/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "dev:next": "next dev ./renderer",
    "dev:static": "serve ./build",
    "start": "electron .",
    "build-renderer": "next build ./renderer",
    "build-electron": "tsc -p tsconfig.json",
    "build": "npm run build-renderer && npm run build-electron && npm run copy",
    "check": "npm run format && npm run lint && npm run build",
    "copy": "cp -rf ./electron-src/*.mjs ./build",
    "format": "prettier . --write",
    "lint": "eslint .",
    "pack-app": "npm run build && electron-builder --dir",
    "pack": "electron-builder --help",
    "test": "vitest run ./tests",
    "dist": "npm run build && DEBUG=electron-builder electron-builder --publish never",
    "dist-debug": "'./dist/mac/StudioRack.app/Contents/MacOS/StudioRack' --remote-debugging-port=8315",
    "type-check": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiorack/studiorack-app.git"
  },
  "keywords": [
    "audio",
    "plugin",
    "app",
    "vst",
    "daw",
    "metadata",
    "search"
  ],
  "build": {
    "appId": "io.github.studiorack",
    "productName": "StudioRack",
    "artifactName": "studiorack-${os}.${ext}",
    "asar": true,
    "asarUnpack": [
      "node_modules"
    ],
    "files": [
      "build",
      "renderer"
    ],
    "directories": {
      "buildResources": "renderer/public/icons"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "win": {
      "target": "nsis"
    },
    "extraMetadata": {
      "main": "build/electron-src/index.js"
    }
  },
  "author": "kmturley",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/studiorack/studiorack-app/issues"
  },
  "homepage": "https://github.com/studiorack/studiorack-app#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/react": "^16.3.1",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@vitejs/plugin-react": "^5.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "prettier": "^3.7.4",
    "serve": "^14.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@open-audio-stack/core": "^0.1.55",
    "electron-is-dev": "^3.0.1",
    "electron-next": "^3.1.5",
    "fix-path": "^5.0.0",
    "gray-matter": "^4.0.3",
    "next": "^16.2.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "slugify": "^1.6.6"
  },
  "overrides": {
    "path-to-regexp": "^8.1.0",
    "postcss": "^8.5.10"
  }
}
